{
    "type": "package",
    "name": "intrepidshape/elm-web3",
    "summary": "Type-safe EVM blockchain interaction for Elm. Zero runtime exceptions.",
    "license": "MIT",
    "version": "1.4.4",
    "exposed-modules": [
        "Web3",
        "Web3.Types",
        "Web3.Wallet",
        "Web3.Transaction",
        "Web3.Contract.Call",
        "Web3.Contract.Send",
        "Web3.Contract.Event",
        "Web3.Chain",
        "Web3.Abi.Decode",
        "Web3.Abi.Encode",
        "Web3.Abi.Calldata",
        "Web3.BigInt",
        "Web3.Units",
        "Web3.Block",
        "Web3.Fee",
        "Web3.Multicall",
        "Web3.Sign",
        "Web3.Balance",
        "Web3.Query",
        "Web3.Crypto",
        "Web3.Subscription"
    ],
    "elm-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "elm/core": "1.0.5 <= v < 2.0.0",
        "elm/json": "1.1.3 <= v < 2.0.0"
    },
    "test-dependencies": {
        "elm-explorations/test": "2.2.1 <= v < 3.0.0"
    }
}
